{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Media Enrichment Request",
  "description": "Input contract for the media-enrichment Skill",
  "type": "object",
  "required": ["schema_version", "run_id", "article", "materials", "claims", "config"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "article": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["material_id", "aihot_permalink", "source_url", "title", "selected_claim_ids"],
        "properties": {
          "material_id": {
            "type": "string",
            "minLength": 1
          },
          "aihot_permalink": {
            "type": "string",
            "format": "uri"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "selected_claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "copyright_review": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": ["unknown", "restricted", "known_allowed"]
              },
              "reviewed_by": {
                "type": ["string", "null"]
              },
              "reviewed_at": {
                "type": ["string", "null"]
              },
              "evidence": {
                "type": ["string", "null"]
              }
            }
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "claim_text", "material_id", "source_url", "source_excerpt"],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "claim_text": {
            "type": "string"
          },
          "material_id": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "source_excerpt": {
            "type": "string"
          },
          "numbers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "chart_group": {
            "type": "string",
            "description": "Explicit comparison group (benchmark/metric family). Required for a claim's numbers to be chartable; values from different chart_groups are never merged."
          },
          "metric_name": {
            "type": "string",
            "description": "Metric name inside the chart_group (e.g. Elo, score). Required for charting."
          },
          "series_label": {
            "type": "string",
            "description": "Label of this data point in charts. Required for charting."
          },
          "unit": {
            "type": "string",
            "description": "Explicit unit for plain numbers (optional)."
          },
          "time_value": {
            "type": "string",
            "description": "Real time value (e.g. ISO date). Timeline charts are generated only when every point has one; input order is never used as a time axis."
          }
        }
      }
    },
    "config": {
      "type": "object",
      "required": ["network_mode", "upload_mode"],
      "properties": {
        "network_mode": {
          "type": "string",
          "enum": ["live", "offline_fixture"]
        },
        "upload_mode": {
          "type": "string",
          "enum": ["dry_run", "wechat_image_host", "stable_storage"]
        },
        "max_images_per_material": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "max_total_images": {
          "type": "integer",
          "minimum": 1,
          "default": 12
        },
        "min_width": {
          "type": "integer",
          "minimum": 1,
          "default": 640
        },
        "min_height": {
          "type": "integer",
          "minimum": 1,
          "default": 360
        },
        "max_download_bytes": {
          "type": "integer",
          "minimum": 1024,
          "default": 15728640
        },
        "max_pixels": {
          "type": "integer",
          "minimum": 1000,
          "default": 40000000
        },
        "allow_unknown_license_for_publish": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
