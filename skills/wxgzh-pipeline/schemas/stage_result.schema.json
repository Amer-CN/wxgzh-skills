{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StageResult",
  "type": "object",
  "required": [
    "run_id",
    "stage",
    "status",
    "outputs"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "stage": {
      "type": "string"
    },
    "status": {
      "enum": [
        "success",
        "failed"
      ]
    },
    "outputs": {
      "type": "object"
    },
    "errors": {
      "type": "array"
    }
  }
}