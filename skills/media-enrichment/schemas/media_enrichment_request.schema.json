{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Media Enrichment Request",
 "description": "Input contract for the media-enrichment Skill",
 "type": "object",
 "required": [
  "schema_version",
  "run_id",
  "article",
  "materials",
  "claims",
  "config"
 ],
 "properties": {
  "schema_version": {
   "type": "string",
   "const": "1.0"
  },
  "run_id": {
   "type": "string",
   "minLength": 1
  },
  "article": {
   "type": "object",
   "required": [
    "path",
    "sha256"
   ],
   "properties": {
    "path": {
     "type": "string",
     "minLength": 1
    },
    "sha256": {
     "type": "string",
     "pattern": "^[a-fA-F0-9]{64}$"
    }
   }
  },
  "materials": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "material_id",
     "aihot_permalink",
     "source_url",
     "title",
     "selected_claim_ids"
    ],
    "properties": {
     "material_id": {
      "type": "string",
      "minLength": 1
     },
     "aihot_permalink": {
      "type": ["string", "null"],
      "format": "uri",
      "description": "77W/OBS-359:provenance=supplemental 时允许 null(无站内页);normal 时仍须 aihot 域 uri"
     },
     "source_url": {
      "type": "string",
      "format": "uri"
     },
     "title": {
      "type": "string"
     },
     "selected_claim_ids": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "copyright_review": {
      "type": "object",
      "properties": {
       "status": {
        "type": "string",
        "enum": [
         "unknown",
         "restricted",
         "known_allowed"
        ]
       },
       "reviewed_by": {
        "type": [
         "string",
         "null"
        ]
       },
       "reviewed_at": {
        "type": [
         "string",
         "null"
        ]
       },
       "evidence": {
        "type": [
         "string",
         "null"
        ]
       }
      }
     },
     "aihot_internal_url": {
      "type": "string",
      "format": "uri",
      "description": "76E/OBS-260:AI HOT 站内页(links.aihot)直出 HTML,抓图优先来源"
     },
     "provenance": {
      "type": "string",
      "enum": [
       "normal",
       "supplemental"
      ],
      "description": "76H/OBS-268:normal=aihot dedup 池来源(默认);supplemental=权威补充来源(官方博客/公告/releases,携带 source_url+抓取证据+登记理由,不要求 dedup 映射)"
     }
    }
   }
  },
  "asset_approvals": {
   "type": "array",
   "description": "User approvals bound to one frozen discovery manifest and one stable asset identity.",
   "items": {
    "type": "object",
    "required": [
     "asset_id",
     "material_id",
     "source_page_url",
     "resolved_original_url",
     "asset_sha256",
     "asset_identity_sha256",
     "discovery_manifest_sha256",
     "approval_id",
     "approved_scope",
     "approved_by",
     "approved_at",
     "approval_evidence_sha256"
    ],
    "properties": {
     "asset_id": {
      "type": "string",
      "minLength": 1
     },
     "material_id": {
      "type": "string",
      "minLength": 1
     },
     "source_page_url": {
      "type": "string",
      "format": "uri"
     },
     "resolved_original_url": {
      "type": "string",
      "format": "uri"
     },
     "asset_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
     },
     "asset_identity_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
     },
     "discovery_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
     },
     "approval_id": {
      "type": "string",
      "minLength": 1
     },
     "approved_scope": {
      "type": "string",
      "const": "single_asset"
     },
     "approved_by": {
      "type": "string",
      "enum": ["user", "auto_rule", "auto_approve"],
      "description": "77W/OBS-357:审批车道——user=真实用户动作(需 user_images.json 或审批留痕证据);auto_rule=规则车道(依据必填);auto_approve=76R/OBS-289 遗留值(等同 auto_rule)"
     },
     "basis": {
      "type": "string",
      "minLength": 1,
      "description": "77W/OBS-357:auto_* 车道必填——依据=合同/规则条号(如 76R/OBS-289、04 合同 copyright_policy 节)"
     },
     "approved_at": {
      "type": "string",
      "minLength": 1
     },
     "approval_evidence_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
     }
    }
   }
  },
  "claims": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "claim_id",
     "claim_text",
     "material_id",
     "source_url",
     "source_excerpt"
    ],
    "properties": {
     "claim_id": {
      "type": "string",
      "minLength": 1
     },
     "claim_text": {
      "type": "string"
     },
     "material_id": {
      "type": "string",
      "minLength": 1
     },
     "source_url": {
      "type": "string",
      "format": "uri"
     },
     "source_excerpt": {
      "type": "string"
     },
     "numbers": {
      "type": "array",
      "items": {
      "description": "77B/OBS-310:数字点阵,元素仅 string 或 {value: number, unit};chart_group/metric_name/series_label/time_value 一律在 claim 级,禁止进 numbers 数组。",
       "oneOf": [
        {
         "type": "string"
        },
        {
         "type": "object",
         "required": [
          "value"
         ],
         "properties": {
          "value": {
           "type": "number"
          },
          "unit": {
           "type": "string"
          }
         },
         "additionalProperties": false
        }
       ]
      }
     },
     "chart_group": {
      "type": "string",
      "description": "Explicit comparison group (benchmark/metric family). Required for a claim's numbers to be chartable; values from different chart_groups are never merged."
     },
     "metric_name": {
      "type": "string",
      "description": "Metric name inside the chart_group (e.g. Elo, score). Required for charting."
     },
     "series_label": {
      "type": "string",
      "description": "Label of this data point in charts. Required for charting."
     },
     "unit": {
      "type": "string",
      "description": "Explicit unit for plain numbers (optional)."
     },
     "time_value": {
      "type": "string",
      "description": "Real time value (e.g. ISO date). Timeline charts are generated only when every point has one; input order is never used as a time axis."
     }
    }
   }
  },
  "config": {
   "type": "object",
   "required": [
    "network_mode",
    "upload_mode"
   ],
   "properties": {
    "network_mode": {
     "type": "string",
     "enum": [
      "live",
      "offline_fixture"
     ]
    },
    "upload_mode": {
     "type": "string",
     "enum": [
      "dry_run",
      "wechat_image_host",
      "stable_storage",
      "wechat_audit"
     ]
    },
    "max_images_per_material": {
     "type": "integer",
     "minimum": 1,
     "default": 3
    },
    "max_total_images": {
     "type": "integer",
     "minimum": 1,
     "default": 12
    },
    "min_width": {
     "type": "integer",
     "minimum": 1,
     "default": 640
    },
    "min_height": {
     "type": "integer",
     "minimum": 1,
     "default": 360
    },
    "max_download_bytes": {
     "type": "integer",
     "minimum": 1024,
     "default": 15728640
    },
    "max_pixels": {
     "type": "integer",
     "minimum": 1000,
     "default": 40000000
    },
    "allow_unknown_license_for_publish": {
     "type": "boolean",
     "default": false
    },
    "domain_blacklist": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     },
     "description": "76C/OBS-248: 来源域名黑名单(命中即拒);首批 ithome.com / img.ithome.com"
    },
    "discovery_budget": {
     "type": "integer",
     "minimum": 1,
     "description": "76E/OBS-260:discovery 阶段独立抓图预算(与 max_total_images 分离);缺省=max(24, 3×max_total_images)"
    }
   }
  },
  "pool_items": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "title",
     "source_url",
     "aihot_permalink"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "title": {
      "type": "string"
     },
     "summary": {
      "type": "string"
     },
     "source_url": {
      "type": "string",
      "format": "uri"
     },
     "aihot_permalink": {
      "type": "string",
      "format": "uri"
     },
     "links": {
      "type": "object"
     }
    }
   },
   "description": "76C/OBS-254: 全池潜力源(aihot deduplicated_items),discover 扩池扫描用;可选"
  },
  "user_images": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "url"
    ],
    "properties": {
     "url": {
      "type": "string",
      "format": "uri"
     },
     "caption": {
      "type": "string"
     },
     "source_url": {
      "type": "string",
      "format": "uri"
     }
    }
   },
   "description": "76C/OBS-255: 用户供图直链清单(user_provided,免版权审批,责任自负);可选"
  }
 }
}
