# wxgzh-pipeline 配置示例 —— 复制为项目根 .env，填入你自己的公众号凭据。
# 本 Skill 只从 .env 读取；绝不把真实值写入代码、证据包或便携安装包。

# 微信公众号（草稿创建 + 图片上传所需）
WECHAT_APP_ID=your_wechat_app_id_here
WECHAT_APP_SECRET=your_wechat_app_secret_here

# 可选：跨电脑路径覆盖（留空则自动发现）
# WXGZH_PROJECT_ROOT=/absolute/path/to/project
# AGENT_SKILLS_HOME=/absolute/path/to/.agents/skills
